# ==========================================================================
# WISE NEWS — variáveis de ambiente (exemplo). NÃO coloque segredos reais aqui.
# Para desenvolvimento local do Worker use apps/api/.dev.vars (mesmo formato).
# Em produção use `wrangler secret put <NOME>`.
# ==========================================================================

# --- IA (camada independente de provedor; começa com Anthropic Claude) ----
# Sem esta chave o sistema CONTINUA coletando; o processamento fica "pending".
ANTHROPIC_API_KEY=
# Modelo configurável — nunca fixe permanentemente no código.
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_MAX_TOKENS=4096
AI_MONTHLY_BUDGET_USD=50

# --- Reddit (fonte principal). OAuth "script"/"web app" ------------------
# Sem credenciais, o adaptador usa o feed público .json (limitado e best-effort).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wise-news/0.1 (by /u/your_username)

# --- GitHub (Issues / Discussions / releases) ----------------------------
# Token opcional aumenta o rate limit de 60 -> 5000 req/h.
GITHUB_TOKEN=

# --- Stack Exchange / Stack Overflow -------------------------------------
# Key opcional aumenta a cota diária.
STACKEXCHANGE_KEY=

# --- Autenticação do painel administrativo -------------------------------
# Segredo usado para assinar sessões (HMAC). Gere com: openssl rand -hex 32
AUTH_SESSION_SECRET=
# Admin inicial criado pelo seed (troque a senha após o primeiro login).
SEED_ADMIN_PHONE=+5500000000000
SEED_ADMIN_PASSWORD=change-me-now

# --- Web Push (VAPID). Gere com: npx web-push generate-vapid-keys --------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wisenews.example

# --- URLs públicas -------------------------------------------------------
PUBLIC_API_URL=http://localhost:8787
PUBLIC_WEB_URL=http://localhost:5173

# --- Cloudflare (para deploy; ver docs/DEPLOY.md) ------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
